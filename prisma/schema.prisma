generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  userType  String   @default("customer") @map("user_type")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  orders    Order[]
  cartItems CartItem[]
  addresses Address[]

  @@map("users")
}

model Product {
  id                 Int            @id @default(autoincrement()) @map("product_id")
  status             String         @default("INACTIVE")
  stockStatus        Boolean        @default(true) @map("stock_status")
  prodMarket         String         @default("DRAFT") @map("prod_market")
  prodType           String         @default("Product") @map("prod_type")
  prodCategoryName   String?        @map("prod_category_name")
  prodName           String         @map("prod_name")
  prodSubtitle       String?        @map("prod_subtitle")
  prodDescription    String         @db.Text @map("prod_description")
  prodImg            String         @map("prod_img")
  prodPrice          Decimal        @db.Decimal(10, 2) @map("prod_price")
  chargeTax          Boolean        @default(false) @map("charge_tax")
  tagsCategory       String?        @db.Text @map("tags_category")
  tagsMeta           String?        @db.Text @map("tags_meta")
  tagsGa4            String?        @db.Text @map("tags_ga4")
  featuredOnHomepage Boolean        @default(false) @map("featured_on_homepage")
  showInNewArrivals  Boolean        @default(false) @map("show_in_new_arrivals")
  returnPolicyDoc    String?        @map("return_policy_doc")
  isDeleted          Boolean        @default(false) @map("is_deleted")
  createdBy          String?        @map("created_by")
  updatedBy          String?        @map("updated_by")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  baseSku            String?        @map("base_sku")
  prodSubCategoryName String?       @map("prod_sub_category_name")
  categoryId         Int            @map("category_id")
  subCategoryId      Int            @map("sub_category_id")
  category           Category       @relation(fields: [categoryId], references: [id])
  subCategory        SubCategory    @relation(fields: [subCategoryId], references: [id])
  productImages      ProductImage[]
  productSkus        ProductSku[]
  productSpecs       ProductSpec[]

  @@index([status, prodMarket, isDeleted])
  @@index([prodCategoryName])
  @@index([featuredOnHomepage])
  @@index([showInNewArrivals])
  @@index([createdAt])
  @@index([categoryId])
  @@index([subCategoryId])
  @@map("products")
}

model Order {
  id              Int         @id @default(autoincrement())
  userId          Int         @map("user_id")
  orderNumber     String      @unique @map("order_number")
  email           String
  firstName       String      @map("first_name")
  lastName        String      @map("last_name")
  address         String
  apartment       String?
  city            String
  state           String
  zipCode         String      @map("zip_code")
  phone           String
  subtotal        Decimal     @db.Decimal(10, 2)
  shippingFee     Decimal     @db.Decimal(10, 2) @map("shipping_fee")
  tax             Decimal     @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  paymentMethod   String      @map("payment_method")
  status          String      @default("pending")
  createdAt       DateTime    @default(now()) @map("created_at")
  user            User        @relation(fields: [userId], references: [id])
  orderItems      OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  productId   Int      @map("product_id")
  skuId       Int?     @map("sku_id")
  productName String   @map("product_name")
  specs       String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal  @db.Decimal(10, 2)
  order       Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Category {
  id            Int           @id @default(autoincrement()) @map("category_id")
  name          String        @unique
  description   String?       @db.Text
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  subcategories SubCategory[]
  products      Product[]

  @@index([isActive])
  @@index([name])
  @@map("categories")
}

model SubCategory {
  id          Int       @id @default(autoincrement()) @map("sub_category_id")
  name        String
  description String?   @db.Text
  categoryId  Int       @map("category_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  category    Category  @relation(fields: [categoryId], references: [id])
  products    Product[]

  @@unique([name, categoryId])
  @@index([categoryId, isActive])
  @@index([name])
  @@map("subcategories")
}

model ProductImage {
  id        Int      @id @default(autoincrement()) @map("product_image_id")
  productId Int      @map("product_id")
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductSpec {
  id          Int                 @id @default(autoincrement()) @map("product_spec_id")
  productId   Int                 @map("product_id")
  name        String
  description String?             @db.Text
  orderNo     Int                 @default(0) @map("order_no")
  createdAt   DateTime            @default(now()) @map("created_at")
  product     Product             @relation(fields: [productId], references: [id])
  attributes  ProductSpecAttr[]

  @@index([productId])
  @@map("product_specs")
}

model ProductSpecAttr {
  id        Int         @id @default(autoincrement()) @map("product_spec_attr_id")
  specId    Int         @map("spec_id")
  name      String
  value     String
  type      String      @default("text")
  createdAt DateTime    @default(now()) @map("created_at")
  spec      ProductSpec @relation(fields: [specId], references: [id])

  @@index([specId])
  @@map("product_spec_attrs")
}

model ProductSku {
  id             Int      @id @default(autoincrement()) @map("product_sku_id")
  productId      Int      @map("product_id")
  skuCode        String   @unique @map("sku_code")
  variantKeys    String?  @db.Text @map("variant_keys")
  variantDetails String?  @db.Text @map("variant_details")
  description    String?  @db.Text
  price          Decimal  @db.Decimal(10, 2)
  stock          Int      @default(0)
  images         String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  product        Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_skus")
}

model CommonIndex {
  id        Int      @id @default(autoincrement()) @map("common_index_id")
  name      String   @unique
  type      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("common_indexes")
}

model AuditTrail {
  id         Int      @id @default(autoincrement()) @map("audit_id")
  userId     Int      @map("user_id")
  userEmail  String   @map("user_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   String?  @db.Text
  ipAddress  String   @map("ip_address")
  userAgent  String   @db.Text @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@map("audit_trails")
}

model CartItem {
  id        Int      @id @default(autoincrement()) @map("cart_item_id")
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  skuId     Int?     @map("sku_id")
  quantity  Int      @default(1)
  specs     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([productId])
  @@map("cart_items")
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  address   String
  apartment String?
  city      String
  state     String
  zipCode   String   @map("zip_code")
  phone     String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

model ShippingFee {
  id        Int      @id @default(autoincrement())
  type      String
  value     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("shipping_fees")
}
