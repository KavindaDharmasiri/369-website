generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  password    String
  userType    String     @default("customer") @map("user_type")
  isActive    Boolean    @default(true) @map("is_active")
  firstName   String?    @map("first_name")
  lastName    String?    @map("last_name")
  phone       String?
  avatarUrl   String?    @map("avatar_url")
  dateOfBirth DateTime?  @map("date_of_birth")
  createdAt   DateTime   @default(now()) @map("created_at")
  addresses   Address[]
  cartItems   CartItem[]
  orders      Order[]
  wishlistItems WishlistItem[]
  reviews     Review[]

  @@map("users")
}

model AppSetting {
  id          Int      @id @default(autoincrement()) @map("setting_id")
  key         String   @unique
  value       String
  type        String   @default("string")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Notification {
  id        Int      @id @default(autoincrement()) @map("notification_id")
  type      String
  title     String
  message   String
  recipient String   @default("admin")
  entityId  String?  @map("entity_id")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([recipient, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AdBanner {
  id        Int      @id @default(autoincrement()) @map("banner_id")
  title     String
  imageUrl  String   @map("image_url")
  linkUrl   String?  @map("link_url")
  position  String   @default("home")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([position, isActive])
  @@map("ad_banners")
}

model Product {
  id                  Int            @id @default(autoincrement()) @map("product_id")
  status              String         @default("INACTIVE")
  stockStatus         Boolean        @default(true) @map("stock_status")
  prodMarket          String         @default("DRAFT") @map("prod_market")
  prodType            String         @default("Product") @map("prod_type")
  prodCategoryName    String?        @map("prod_category_name")
  prodName            String         @map("prod_name")
  prodSubtitle        String?        @map("prod_subtitle")
  prodDescription     String         @map("prod_description") @db.Text
  prodImg             String         @map("prod_img")
  prodPrice           Decimal        @map("prod_price") @db.Decimal(10, 2)
  chargeTax           Boolean        @default(false) @map("charge_tax")
  tagsCategory        String?        @map("tags_category") @db.Text
  tagsMeta            String?        @map("tags_meta") @db.Text
  tagsGa4             String?        @map("tags_ga4") @db.Text
  featuredOnHomepage  Boolean        @default(false) @map("featured_on_homepage")
  showInNewArrivals   Boolean        @default(false) @map("show_in_new_arrivals")
  returnPolicyDoc     String?        @map("return_policy_doc")
  isDeleted           Boolean        @default(false) @map("is_deleted")
  createdBy           String?        @map("created_by")
  updatedBy           String?        @map("updated_by")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  baseSku             String?        @map("base_sku")
  prodSubCategoryName String?        @map("prod_sub_category_name")
  categoryId          Int            @map("category_id")
  subCategoryId       Int            @map("sub_category_id")
  productImages       ProductImage[]
  productSkus         ProductSku[]
  productSpecs        ProductSpec[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  wishlistItems       WishlistItem[]
  reviews             Review[]
  category            Category       @relation(fields: [categoryId], references: [id])
  subCategory         SubCategory    @relation(fields: [subCategoryId], references: [id])
  discounts           Discount[]

  @@index([status, prodMarket, isDeleted])
  @@index([prodCategoryName])
  @@index([featuredOnHomepage])
  @@index([showInNewArrivals])
  @@index([createdAt])
  @@index([prodPrice])
  @@index([categoryId])
  @@index([subCategoryId])
  @@map("products")
}

model Order {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  total         Decimal     @db.Decimal(10, 2)
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now()) @map("created_at")
  address       String
  apartment     String?
  city          String
  email         String
  firstName     String      @map("first_name")
  lastName      String      @map("last_name")
  orderNumber   String      @unique @map("order_number")
  paymentMethod String      @map("payment_method")
  phone         String
  shippingFee   Decimal     @map("shipping_fee") @db.Decimal(10, 2)
  state         String
  subtotal      Decimal     @db.Decimal(10, 2)
  tax           Decimal     @db.Decimal(10, 2)
  zipCode       String      @map("zip_code")
  couponCode    String?     @map("coupon_code")
  discount      Decimal     @default(0) @db.Decimal(10, 2)
  productDiscount Decimal  @default(0) @map("product_discount") @db.Decimal(10, 2)
  couponId      Int?        @map("coupon_id")
  orderItems    OrderItem[]
  user          User        @relation(fields: [userId], references: [id])
  coupon        Coupon?     @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          Int         @id @default(autoincrement())
  orderId     Int         @map("order_id")
  productId   Int         @map("product_id")
  skuId       Int?        @map("sku_id")
  productName String      @map("product_name")
  specs       String?     @db.Text
  price       Decimal     @db.Decimal(10, 2)
  originalPrice Decimal  @default(0) @map("original_price") @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal     @db.Decimal(10, 2)
  order       Order       @relation(fields: [orderId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  sku         ProductSku? @relation(fields: [skuId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Category {
  id            Int           @id @default(autoincrement()) @map("category_id")
  name          String        @unique
  description   String?       @db.Text
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  products      Product[]
  subcategories SubCategory[]
  discounts     Discount[]

  @@index([isActive])
  @@index([name])
  @@map("categories")
}

model SubCategory {
  id          Int       @id @default(autoincrement()) @map("sub_category_id")
  name        String
  description String?   @db.Text
  categoryId  Int       @map("category_id")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]
  category    Category  @relation(fields: [categoryId], references: [id])
  discounts   Discount[]

  @@unique([name, categoryId])
  @@index([categoryId, isActive])
  @@index([name])
  @@map("subcategories")
}

model ProductImage {
  id        Int      @id @default(autoincrement()) @map("product_image_id")
  productId Int      @map("product_id")
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductSpec {
  id          Int               @id @default(autoincrement()) @map("product_spec_id")
  productId   Int               @map("product_id")
  name        String
  description String?           @db.Text
  orderNo     Int               @default(0) @map("order_no")
  createdAt   DateTime          @default(now()) @map("created_at")
  attributes  ProductSpecAttr[]
  product     Product           @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_specs")
}

model ProductSpecAttr {
  id        Int         @id @default(autoincrement()) @map("product_spec_attr_id")
  specId    Int         @map("spec_id")
  name      String
  value     String
  type      String      @default("text")
  createdAt DateTime    @default(now()) @map("created_at")
  spec      ProductSpec @relation(fields: [specId], references: [id])

  @@index([specId])
  @@map("product_spec_attrs")
}

model ProductSku {
  id             Int      @id @default(autoincrement()) @map("product_sku_id")
  productId      Int      @map("product_id")
  skuCode        String   @unique @map("sku_code")
  variantKeys    String?  @map("variant_keys") @db.Text
  variantDetails String?  @map("variant_details") @db.Text
  description    String?  @db.Text
  price          Decimal  @db.Decimal(10, 2)
  stock          Int      @default(0)
  images         String?  @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  product        Product  @relation(fields: [productId], references: [id])
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]

  @@index([productId])
  @@map("product_skus")
}

model CommonIndex {
  id        Int      @id @default(autoincrement()) @map("common_index_id")
  name      String   @unique
  type      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("common_indexes")
}

model AuditTrail {
  id         Int      @id @default(autoincrement()) @map("audit_id")
  userId     Int      @map("user_id")
  userEmail  String   @map("user_email")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   String?  @db.Text
  ipAddress  String   @map("ip_address")
  userAgent  String   @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_trails")
}

model CartItem {
  id        Int         @id @default(autoincrement()) @map("cart_item_id")
  userId    Int         @map("user_id")
  productId Int         @map("product_id")
  skuId     Int?        @map("sku_id")
  quantity  Int         @default(1)
  specs     String?     @db.Text
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  user      User        @relation(fields: [userId], references: [id])
  product   Product     @relation(fields: [productId], references: [id])
  sku       ProductSku? @relation(fields: [skuId], references: [id])

  @@index([userId])
  @@index([productId])
  @@map("cart_items")
}

model Address {
  address_id Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  address    String
  apartment  String?
  city       String
  state      String
  zipCode    String   @map("zip_code")
  phone      String
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

model ShippingFee {
  shipping_fee_id Int      @id @default(autoincrement())
  type            String
  value           Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("shipping_fees")
}

model WishlistItem {
  id        Int         @id @default(autoincrement()) @map("wishlist_id")
  userId    Int         @map("user_id")
  productId Int         @map("product_id")
  skuId     Int?        @map("sku_id")
  createdAt DateTime    @default(now()) @map("created_at")
  user      User        @relation(fields: [userId], references: [id])
  product   Product     @relation(fields: [productId], references: [id])
  sku       ProductSku? @relation(fields: [skuId], references: [id])

  @@unique([userId, productId, skuId])
  @@index([userId])
  @@index([productId])
  @@map("wishlist_items")
}

model Review {
  id        Int      @id @default(autoincrement()) @map("review_id")
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  rating    Int
  comment   String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model Coupon {
  id            Int       @id @default(autoincrement()) @map("coupon_id")
  code          String    @unique
  description   String?   @db.Text
  discountType  String    @default("percentage") @map("discount_type")
  discountValue Decimal   @db.Decimal(10, 2) @map("discount_value")
  minSubtotal   Decimal?  @db.Decimal(10, 2) @map("min_subtotal")
  maxDiscount   Decimal?  @db.Decimal(10, 2) @map("max_discount")
  validFrom     DateTime? @map("valid_from")
  validUntil    DateTime? @map("valid_until")
  isActive      Boolean   @default(true) @map("is_active")
  maxUses       Int?      @map("max_uses")
  usedCount     Int       @default(0) @map("used_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  orders        Order[]

  @@index([isActive])
  @@map("coupons")
}

model Discount {
  id            Int         @id @default(autoincrement()) @map("discount_id")
  name          String
  description   String?     @db.Text
  discountType  String      @default("percentage") @map("discount_type")
  discountValue Decimal     @db.Decimal(10, 2) @map("discount_value")
  scope         String      @default("product") // product | category | subcategory
  productId     Int?        @map("product_id")
  categoryId    Int?        @map("category_id")
  subCategoryId Int?        @map("sub_category_id")
  isActive      Boolean     @default(true) @map("is_active")
  validFrom     DateTime?   @map("valid_from")
  validUntil    DateTime?   @map("valid_until")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  product       Product?    @relation(fields: [productId], references: [id])
  category      Category?   @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  @@index([scope, isActive])
  @@index([productId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@map("discounts")
}
