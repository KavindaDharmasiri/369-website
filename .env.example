# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Auth — rotate to long random strings
JWT_SECRET="change-me-to-a-long-random-string"
ENCRYPTION_KEY="change-me-to-a-long-random-string"
# Client-side encryption key. MUST match ENCRYPTION_KEY (this value is public).
NEXT_PUBLIC_ENCRYPTION_KEY="change-me-to-a-long-random-string"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Virtual Try-On
# FREE tier (no config needed): the free "instant preview" runs 100% on the
# customer's own device (WebGPU/WebAssembly in the browser). Assets (LiteRT
# wasm runtime + models) are set up automatically by `postinstall` via
# `npm run setup:tryon`. Nothing is charged and nothing is shared between
# customers — one user can never affect another.
#
# PAID tier (photorealistic): served by Replicate, pay-per-request, with a
# per-customer daily quota tracked in the database (package holders never
# share quotas).
# Paid package: price, daily limit, validity and store commission (%).
TRYON_PACKAGE_PRICE=4.99
TRYON_PACKAGE_DAILY_LIMIT=20
TRYON_PACKAGE_DAYS=30
TRYON_COMMISSION_PERCENT=10

# Replicate API token from https://replicate.com/account/api-tokens (pay-per-use).
REPLICATE_API_TOKEN=r8_xxxx...
# Replicate IDM-VTON model version and garment category (upper_body | lower_body | dresses).
TRYON_REPLICATE_MODEL=cuuupid/idm-vton
TRYON_REPLICATE_VERSION=0513734a452173b8173e907e3a59d19a36266e55b48528559432bd21c7d7e985
TRYON_REPLICATE_CATEGORY=upper_body
