# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Auth — rotate to long random strings
JWT_SECRET="change-me-to-a-long-random-string"
ENCRYPTION_KEY="change-me-to-a-long-random-string"
# Client-side encryption key. MUST match ENCRYPTION_KEY (this value is public).
NEXT_PUBLIC_ENCRYPTION_KEY="change-me-to-a-long-random-string"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
